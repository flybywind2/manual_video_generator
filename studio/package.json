{
  "name": "manual-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "doctor": "node scripts/doctor.mjs",
    "start": "node src/index.js",
    "supertonic:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supertonic.ps1 -Ensure",
    "supertonic:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/supertonic.ps1 -Ensure -Start",
    "smoke:supertonic": "node src/adapters/supertonic-client.js --smoke",
    "verify": "npm test && npm run doctor",
    "smoke:live": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.78",
    "hyperframes": "0.7.57"
  }
}
