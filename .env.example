# Manual Video Agent local configuration
# Copy this file to .env and fill real internal values. Do not commit .env.

# Shared OpenAI-compatible headers from D:\Python\appendix\appendix.md
MANUAL_AGENT_OPENAI_API_KEY=replace-with-api-key
MANUAL_AGENT_DEP_TICKET=credential:TICKET-
MANUAL_AGENT_SEND_SYSTEM_NAME=manual-video-agent
MANUAL_AGENT_USER_ID=replace-with-ad-id
MANUAL_AGENT_USER_TYPE=AD_ID

# OpenAI-compatible LLM API
# DS API HUB stg/prod base URL must include /v1 only.
MANUAL_AGENT_LLM_BASE_URL=http://api.net:8000/v1
MANUAL_AGENT_LLM_MODEL=QWEN3
# Keep false until the prompt/approval policy is ready for the target system.
MANUAL_AGENT_ENABLE_INTERNAL_PLANNER=false
MANUAL_AGENT_REQUEST_TIMEOUT_SECONDS=30

# OpenAI-compatible VLM API
MANUAL_AGENT_VLM_BASE_URL=http://api.net/vl/v1
MANUAL_AGENT_VLM_MODEL=QWEN3-VL
# Optional overrides. Leave blank to reuse shared values.
MANUAL_AGENT_VLM_API_KEY=
MANUAL_AGENT_VLM_DEP_TICKET=
MANUAL_AGENT_VLM_SEND_SYSTEM_NAME=
MANUAL_AGENT_VLM_USER_ID=
MANUAL_AGENT_VLM_USER_TYPE=

# Elasticsearch based RAG API
MANUAL_AGENT_RAG_INSERT_URL=http://api.net/elastic/v2/insert-doc
MANUAL_AGENT_RAG_RETRIEVE_URL=http://api.net/elastic/v2/retrieve-rrf
MANUAL_AGENT_RAG_DELETE_URL=http://api.net/elastic/v2/delete-doc
MANUAL_AGENT_RAG_DEP_TICKET=
MANUAL_AGENT_RAG_API_KEY=replace-with-rag-key
MANUAL_AGENT_RAG_INDEX_NAME=manual-video-agent
MANUAL_AGENT_RAG_PERMISSION_GROUPS=rag-public
MANUAL_AGENT_ENABLE_RAG_CONTEXT=false

# Reranker API
MANUAL_AGENT_RERANKER_URL=http://api.net/reranker/v2/rerank
MANUAL_AGENT_RERANKER_MODEL=bge-reranker-v2-m3-ko
MANUAL_AGENT_RERANKER_DEP_TICKET=
MANUAL_AGENT_ENABLE_RERANKER=false

# Playwright MCP rehearsal manifest
MANUAL_AGENT_PLAYWRIGHT_MCP_MODE=manifest
# Use live only after Node/npm and @playwright/mcp can run on this host.
# Values: off, manifest, live
MANUAL_AGENT_PLAYWRIGHT_MCP_COMMAND=npx @playwright/mcp@latest --headless
# Optional. Leave blank to let Playwright resolve the bundled/browser-cache executable.
MANUAL_AGENT_PLAYWRIGHT_EXECUTABLE_PATH=

# Local runtime
MANUAL_AGENT_BUNDLE_ROOT=
MANUAL_AGENT_OUTPUT_DIR=output
# For Docker-free internal PC deployment, bootstrap.ps1 sets these to bundle-local paths.
PLAYWRIGHT_BROWSERS_PATH=
HF_HOME=
NPM_CONFIG_CACHE=
REQUESTS_CA_BUNDLE=
NODE_EXTRA_CA_CERTS=
MANUAL_AGENT_TTS_PROVIDER=fake-melotts-compatible
MANUAL_AGENT_TTS_DEVICE=cpu
MANUAL_AGENT_TTS_LANGUAGE=KR
MANUAL_AGENT_TTS_SPEAKER=KR
MANUAL_AGENT_TTS_SPEED=1.0
MANUAL_AGENT_VIDEO_RENDERER=playwright-webm
MANUAL_AGENT_HYPERFRAMES_COMMAND=npx hyperframes render
MANUAL_AGENT_ENABLE_HYPERFRAMES_SKILLS=false
MANUAL_AGENT_HYPERFRAMES_SKILLS_COMMAND=npx hyperframes skills --codex

# Optional OpenCode agent pass over generated package artifacts
MANUAL_AGENT_ENABLE_OPENCODE=false
MANUAL_AGENT_OPENCODE_COMMAND=opencode run --format json
MANUAL_AGENT_OPENCODE_AGENT=
MANUAL_AGENT_OPENCODE_MODEL=
MANUAL_AGENT_OPENCODE_TIMEOUT_SECONDS=600
