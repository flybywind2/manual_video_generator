# Manual Video Agent: OpenCode-only local configuration
# Copy to .env. Keep .env outside OneDrive on company PCs and do not commit it.

# Application
MANUAL_AGENT_OUTPUT_DIR=output
MANUAL_AGENT_ENABLE_TERMINAL_LOGS=true
MANUAL_AGENT_STRICT_MODE=true
MANUAL_AGENT_REQUEST_TIMEOUT_SECONDS=30
MANUAL_AGENT_TARGET_VIDEO_DURATION_SECONDS=0

# Edge/CDP session owned by the backend.
# Use an absolute, short, ASCII-only profile path on company PCs.
MANUAL_AGENT_BROWSER_CHANNEL=msedge
MANUAL_AGENT_USER_DATA_DIR=C:\ManualVideoAgent\runtime\browser-profile
MANUAL_AGENT_PLAYWRIGHT_EXECUTABLE_PATH=
MANUAL_AGENT_BROWSER_RUNNER=launch
# Used only when BROWSER_RUNNER=cdp_attach.
MANUAL_AGENT_CDP_ENDPOINT=http://127.0.0.1:9222
MANUAL_AGENT_AUTH_SERVER_ALLOWLIST=
MANUAL_AGENT_AUTH_NEGOTIATE_DELEGATE_ALLOWLIST=

# OpenCode is the only planning/browser intelligence.
# OpenCode uses its own configured default model; no --model flag is added.
MANUAL_AGENT_ENABLE_OPENCODE=true
MANUAL_AGENT_OPENCODE_COMMAND=opencode run --format json
MANUAL_AGENT_OPENCODE_AGENT=
MANUAL_AGENT_OPENCODE_TIMEOUT_SECONDS=900

# Job-local Playwright MCP connects to the backend-owned CDP endpoint.
MANUAL_AGENT_PLAYWRIGHT_MCP_COMMAND=npx --offline @playwright/mcp

# Supertonic is the only TTS provider. Voice and language are fixed to M1/ko.
MANUAL_AGENT_TTS_PROVIDER=supertonic
MANUAL_AGENT_SUPERTONIC_VOICE=M1
MANUAL_AGENT_SUPERTONIC_LANG=ko
MANUAL_AGENT_SUPERTONIC_AUTO_DOWNLOAD=false
SUPERTONIC_CACHE_DIR=C:\ManualVideoAgent\models\supertonic-3

# Final renderer. HyperFrames and FFmpeg failures are fatal in strict mode.
MANUAL_AGENT_VIDEO_RENDERER=hyperframes
MANUAL_AGENT_HYPERFRAMES_COMMAND=npx --offline hyperframes render
MANUAL_AGENT_ENABLE_HYPERFRAMES_SKILLS=false
MANUAL_AGENT_HYPERFRAMES_SKILLS_COMMAND=npx --offline skills add heygen-com/hyperframes

# Optional Docker-free bundle paths and company CA.
MANUAL_AGENT_BUNDLE_ROOT=
PLAYWRIGHT_BROWSERS_PATH=
NPM_CONFIG_CACHE=
REQUESTS_CA_BUNDLE=
NODE_EXTRA_CA_CERTS=
